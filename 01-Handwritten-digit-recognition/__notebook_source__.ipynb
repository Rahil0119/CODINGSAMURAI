import numpy as np
import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

from sklearn.model_selection import train_test_split
from sklearn.metrics import confusion_matrix, classification_report

import tensorflow as tf
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import Dense, Conv2D, MaxPool2D, Flatten, Dropout
from tensorflow.keras.utils import to_categorical

print("TensorFlow Version:", tf.__version__)





# Load the data using the exact hidden Kaggle paths
train_df = pd.read_csv('/kaggle/input/competitions/digit-recognizer/train.csv')
test_df = pd.read_csv('/kaggle/input/competitions/digit-recognizer/test.csv')

# Separate features and labels
X = train_df.drop(columns=['label']).values
y = train_df['label'].values

# The test set from the competition has no labels, just pixels
X_competition = test_df.values

print("Data Loaded Successfully!")
print(f"Training rows: {X.shape[0]}, Test rows: {X_competition.shape[0]}")


# 1. Normalize pixel values to be between 0 and 1
X = X / 255.0
X_competition = X_competition / 255.0

# 2. Reshape flat arrays into 2D images (28x28) with 1 channel (grayscale)
X = X.reshape(-1, 28, 28, 1)
X_competition = X_competition.reshape(-1, 28, 28, 1)

# 3. One-Hot Encode the labels
y = to_categorical(y, num_classes=10)

# 4. Split training data into Training and Validation sets
X_train, X_val, y_train, y_val = train_test_split(X, y, test_size=0.1, random_state=42)

print(f"Train shape: {X_train.shape}")
print(f"Validation shape: {X_val.shape}")





# Plot a few random images from the dataset
plt.figure(figsize=(10, 4))
for i in range(5):
    plt.subplot(1, 5, i+1)
    plt.imshow(X_train[i].reshape(28, 28), cmap='gray')
    plt.title(f"Label: {np.argmax(y_train[i])}")
    plt.axis('off')
plt.show()





model = Sequential([
    # First Convolutional Block
    Conv2D(filters=32, kernel_size=(5,5), activation='relu', input_shape=(28,28,1)),
    MaxPool2D(pool_size=(2,2)),
    Dropout(0.25),
    
    # Second Convolutional Block
    Conv2D(filters=64, kernel_size=(3,3), activation='relu'),
    MaxPool2D(pool_size=(2,2)),
    Dropout(0.25),
    
    # Flattening and Fully Connected Layers
    Flatten(),
    Dense(256, activation='relu'),
    Dropout(0.5),
    Dense(10, activation='softmax')
])

# FIX: Changed 'categorical_categorical_crossentropy' to 'categorical_crossentropy'
model.compile(optimizer='adam', 
              loss='categorical_crossentropy', 
              metrics=['accuracy'])

model.summary()





# Train the model
history = model.fit(
    X_train, y_train,
    epochs=15, 
    batch_size=64,
    validation_data=(X_val, y_val)
)





# 1. Plot training vs validation accuracy
plt.figure(figsize=(12, 4))
plt.subplot(1, 2, 1)
plt.plot(history.history['accuracy'], label='Train Accuracy')
plt.plot(history.history['val_accuracy'], label='Val Accuracy')
plt.legend()
plt.title('Accuracy Evolution')

# 2. Get predictions on the validation set
y_val_pred = model.predict(X_val)
y_val_pred_classes = np.argmax(y_val_pred, axis=1)
y_val_true = np.argmax(y_val, axis=1)

# 3. Print Classification Report (Precision, Recall, F1)
print("\nClassification Report:\n")
print(classification_report(y_val_true, y_val_pred_classes))





# Generate Confusion Matrix
cm = confusion_matrix(y_val_true, y_val_pred_classes)

plt.figure(figsize=(8, 6))
sns.heatmap(cm, annot=True, fmt='d', cmap='Blues', xticklabels=range(10), yticklabels=range(10))
plt.ylabel('True Label')
plt.xlabel('Predicted Label')
plt.title('Confusion Matrix')
plt.show()





# Predict classes for the competition test dataset
competition_predictions = model.predict(X_competition)
competition_predicted_classes = np.argmax(competition_predictions, axis=1)

# Format into the requested submission layout
submission_df = pd.DataFrame({
    "ImageId": np.arange(1, len(competition_predicted_classes) + 1),
    "Label": competition_predicted_classes
})

# Save to CSV
submission_df.to_csv('submission.csv', index=False)
print("Submission file successfully saved as submission.csv!")


# Save using the modern native Keras format
model.save('mnist_cnn.keras')


import random

# 1. Pick 5 random indices from the competition test dataset
random_indices = random.sample(range(len(X_competition)), 5)

# 2. Set up the plot display
plt.figure(figsize=(12, 5))

for i, index in enumerate(random_indices):
    # Get the image pixels
    test_image = X_competition[index]
    
    # Reshape for the model prediction (expects a batch shape of 1, 28, 28, 1)
    img_for_pred = test_image.reshape(1, 28, 28, 1)
    
    # Make the prediction
    prediction = model.predict(img_for_pred, verbose=0)
    predicted_digit = np.argmax(prediction)
    confidence = np.max(prediction) * 100
    
    # 3. Plot the image visually
    plt.subplot(1, 5, i + 1)
    plt.imshow(test_image.reshape(28, 28), cmap='gray')
    plt.title(f"Pred: {predicted_digit}\n({confidence:.1f}%)", color='green' if confidence > 90 else 'orange')
    plt.axis('off')

plt.tight_layout()
plt.show()



